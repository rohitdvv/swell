# ---- Swell environment ----
# Copy to .env.local for local dev; set the same vars in your Vercel project
# (Settings → Environment Variables) for production.

# ============================================================
# REQUIRED — the app will NOT boot without these.
# Sign-in runs on Clerk. ClerkProvider wraps every page and clerkMiddleware
# runs on every request, so a missing key returns "Internal Server Error" on
# the WHOLE site, including the public landing page. Get both from the Clerk
# dashboard → API keys. NEXT_PUBLIC_* is inlined at build time, so set it
# before the build and redeploy after changing it.
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk's hosted sign-in/up pages live, and where to land afterward.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/console
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pricing

# ============================================================
# REQUIRED IN PRODUCTION (optional locally).
# Local dev uses embedded Postgres (PGlite) automatically — no setup. On Vercel
# the filesystem is read-only, so PGlite cannot persist; set a real Postgres
# connection string (e.g. a free Neon database). Same SQL both places.
# ============================================================
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/swell?sslmode=require

# Public base URL (absolute OG / share image links). Set to your deployed URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# OPTIONAL — each is an upgrade; the app degrades gracefully without it.
# ============================================================

# Marketing copy generation. If neither key is set, a high-quality deterministic
# on-brand generator is used (fully offline, free).
#   - ANTHROPIC_API_KEY → Claude Sonnet (per spec)
#   - GROQ_API_KEY      → free Llama-3.3-70b fallback
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Weather + holidays are free & keyless (Open-Meteo + Nager.Date). Optionally
# layer real concerts/sports near the venue (free Ticketmaster tier):
# TICKETMASTER_API_KEY=

# Subscriptions. Without a key, billing runs in DEMO mode (activates instantly
# so the flow is fully visible). Add a Stripe TEST key for real checkout — no
# real charges. Webhook secret enables live subscription lifecycle sync.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Local data (embedded DB + poster cache) lives in ~/.swell by default —
# deliberately OUTSIDE the project so the dev file-watcher never reload-loops.
# SWELL_DATA_DIR=/custom/path
