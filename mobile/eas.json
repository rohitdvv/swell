    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://swell-ten-theta.vercel.app" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
